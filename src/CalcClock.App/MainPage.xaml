<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="CalcClock_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CalcClock_App"
    xmlns:conv="using:CalcClock_App.Converters"
    xmlns:core="using:CalcClock.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:StringToVisibilityConverter x:Key="StringToVisibility" />

        <Style x:Key="CalcButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <!-- Same size/shape as CalcButtonStyle, so "=" lines up with the rest of the keypad;
             only its accent coloring (from AccentButtonStyle) is meant to stand out. -->
        <Style x:Key="AccentCalcButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </Page.Resources>

    <Grid Padding="16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Units settings -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="CalcClock" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button x:Name="UnitsButton" Grid.Column="1">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Setting" />
                    <TextBlock Text="Units" VerticalAlignment="Center" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout x:Name="UnitsFlyout" Opening="UnitsFlyout_Opening">
                        <StackPanel Spacing="8" MinWidth="200">
                            <TextBlock Text="Enabled units" Style="{StaticResource BaseTextBlockStyle}" />
                            <TextBlock Text="At least one unit must stay enabled." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <ToggleSwitch x:Name="YearToggle" Header="Year" OnContent="" OffContent="" Tag="Year" Toggled="UnitToggle_Toggled" />
                            <ToggleSwitch x:Name="MonthToggle" Header="Month" OnContent="" OffContent="" Tag="Month" Toggled="UnitToggle_Toggled" />
                            <ToggleSwitch x:Name="DayToggle" Header="Day" OnContent="" OffContent="" Tag="Day" Toggled="UnitToggle_Toggled" />
                            <ToggleSwitch x:Name="HourToggle" Header="Hour" OnContent="" OffContent="" Tag="Hour" Toggled="UnitToggle_Toggled" />
                            <ToggleSwitch x:Name="MinuteToggle" Header="Minute" OnContent="" OffContent="" Tag="Minute" Toggled="UnitToggle_Toggled" />
                            <ToggleSwitch x:Name="SecondToggle" Header="Second" OnContent="" OffContent="" Tag="Second" Toggled="UnitToggle_Toggled" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- Expression history -->
        <TextBlock
            Grid.Row="1"
            x:Name="ExpressionTextBlock"
            Text="{Binding ExpressionText}"
            Visibility="{Binding ExpressionText, Converter={StaticResource StringToVisibility}}"
            HorizontalAlignment="Right"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            FontSize="16" />

        <!-- Error message -->
        <TextBlock
            Grid.Row="2"
            Text="{Binding ErrorMessage}"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}"
            HorizontalAlignment="Right"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            FontSize="16" />

        <!-- Display -->
        <Border Grid.Row="3" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="16" MinHeight="80">
            <Grid>
                <!-- Segmented clock-value display, shown for + and - entry -->
                <ItemsControl
                    ItemsSource="{Binding DisplaySegments}"
                    Visibility="{Binding IsScalarMode, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                    HorizontalAlignment="Right">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="12" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="core:UnitSegmentDisplay">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{x:Bind Text}" FontSize="34" HorizontalAlignment="Center" />
                                <TextBlock Text="{x:Bind Label}" FontSize="12" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Plain scalar display, shown for x and / entry -->
                <TextBlock
                    Text="{Binding ScalarText}"
                    Visibility="{Binding IsScalarMode, Converter={StaticResource BoolToVisibility}}"
                    FontSize="34"
                    HorizontalAlignment="Right"
                    />
            </Grid>
        </Border>

        <!-- Keypad -->
        <Grid Grid.Row="4" Margin="0,8,0,0" RowDefinitions="*,*,*,*,*" ColumnDefinitions="*,*,*,*">
            <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource CalcButtonStyle}" Content="C" Click="ClearButton_Click" />
            <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource CalcButtonStyle}" Content="CE" Click="ClearEntryButton_Click" />
            <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource CalcButtonStyle}" Content="&#x232B;" Click="BackspaceButton_Click" />
            <Button Grid.Row="0" Grid.Column="3" Style="{StaticResource CalcButtonStyle}" Tag="/" Content="&#xF7;" Click="OperatorButton_Click" />

            <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource CalcButtonStyle}" Tag="7" Content="7" Click="DigitButton_Click" />
            <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource CalcButtonStyle}" Tag="8" Content="8" Click="DigitButton_Click" />
            <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource CalcButtonStyle}" Tag="9" Content="9" Click="DigitButton_Click" />
            <Button Grid.Row="1" Grid.Column="3" Style="{StaticResource CalcButtonStyle}" Tag="*" Content="&#xD7;" Click="OperatorButton_Click" />

            <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource CalcButtonStyle}" Tag="4" Content="4" Click="DigitButton_Click" />
            <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource CalcButtonStyle}" Tag="5" Content="5" Click="DigitButton_Click" />
            <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource CalcButtonStyle}" Tag="6" Content="6" Click="DigitButton_Click" />
            <Button Grid.Row="2" Grid.Column="3" Style="{StaticResource CalcButtonStyle}" Tag="-" Content="&#x2212;" Click="OperatorButton_Click" />

            <Button Grid.Row="3" Grid.Column="0" Style="{StaticResource CalcButtonStyle}" Tag="1" Content="1" Click="DigitButton_Click" />
            <Button Grid.Row="3" Grid.Column="1" Style="{StaticResource CalcButtonStyle}" Tag="2" Content="2" Click="DigitButton_Click" />
            <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource CalcButtonStyle}" Tag="3" Content="3" Click="DigitButton_Click" />
            <Button Grid.Row="3" Grid.Column="3" Style="{StaticResource CalcButtonStyle}" Tag="+" Content="+" Click="OperatorButton_Click" />

            <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource CalcButtonStyle}" Tag="0" Content="0" Click="DigitButton_Click" />
            <Button Grid.Row="4" Grid.Column="2" Style="{StaticResource CalcButtonStyle}" Content="." Click="DecimalButton_Click" />
            <Button Grid.Row="4" Grid.Column="3" Style="{StaticResource AccentCalcButtonStyle}" Content="=" Click="EqualsButton_Click" />
        </Grid>
    </Grid>
</Page>
